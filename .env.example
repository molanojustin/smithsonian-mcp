# Smithsonian MCP Server Configuration
# Copy this file to .env and configure your settings

# Required: Get your API key from https://api.data.gov/signup/
SMITHSONIAN_API_KEY=your_api_key_here

# Optional: Server name reported to MCP clients
SERVER_NAME=Smithsonian Open Access

# Optional: Logging level (DEBUG, INFO, WARNING, ERROR). Logs go to stderr.
LOG_LEVEL=INFO
