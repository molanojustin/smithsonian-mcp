# Smithsonian MCP Server Configuration
# Copy this file to .env and configure your settings

# Required: Get your API key from https://api.data.gov/signup/
SMITHSONIAN_API_KEY=your_api_key_here

# Optional: Server name reported to MCP clients
SERVER_NAME=Smithsonian Open Access

# Optional: Logging level (DEBUG, INFO, WARNING, ERROR). Logs go to stderr.
LOG_LEVEL=INFO

# Optional: Transport of the smithsonian-mcp command. Leave unset (stdio) when an
# MCP client such as Claude Desktop starts the server. Set MCP_TRANSPORT=http to
# serve streamable HTTP at http://MCP_HOST:MCP_PORT/mcp instead.
# MCP_TRANSPORT=stdio
# MCP_HOST=127.0.0.1
# MCP_PORT=8000
